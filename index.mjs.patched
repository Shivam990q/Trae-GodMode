  @property --border-angle {
    syntax: "<angle>";
    inherits: true;
    initial-value: 0turn;
  }

  position: absolute;
  top: 0px;
  left: 0px;
  width: 100%;
  height: 100%;
  display: grid;
  place-content: center;
  color: white;
  text-shadow: 0 1px 0 #000;

  --border-angle: 0turn;
  border-radius: 8px;
  background: transparent;

  animation: ${RX} 2s linear infinite;

  &::before {
    width: 100%;
    height: 100%;
    content: '';
    position: absolute;
    inset: -1.5px;
    border-radius: 8px;
    background: ${e=>e?.isRandom?`
      conic-gradient(
        from var(--border-angle) at 50% 50%,
        rgba(99, 197, 177, 0) 0deg,
        rgba(6, 193, 121, 0.5) 118.8deg,
        #0ECD70 180deg,
        #06C179 237.6deg,
        #63C5B1 360deg
      );
      `:`
      conic-gradient(
        from calc(180deg + var(--border-angle)) at 50% 50%,
        rgba(56, 123, 255, 0) 0deg,
        #387BFF 360deg
      );
      `}
    z-index: 10;
    mask:
      linear-gradient(white 0 0) content-box,
      linear-gradient(white 0 0);
    mask-composite: xor;
        -webkit-mask:
      linear-gradient(white 0 0) content-box,
      linear-gradient(white 0 0);
    -webkit-mask-composite: xor;
    padding: 1.5px;
  }

