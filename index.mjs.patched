    box-sizing: border-box;
    height: 28px;
    padding: 0px var(--Spacers-spacer-6, 6px);
    border-radius: var(--Radius-radius-4, 4px);

    font-weight: var(--body-md-strong-fontWeight, 500);
    font-size: var(--body-md-strong-fontSize, 12px);
    line-height: var(--body-md-strong-lineHeight, 18px);

    cursor: pointer;
    color: var(--vscode-icube--text-text-default, #D1D3DB);

    display: flex;
    align-items: center;
    gap: var(--Spacers-spacer-8, 8px);

    & .codicon {
      color: inherit;
    }

    &.disabled {
      cursor: not-allowed;
      color: var(--vscode-icube--text-text-disabled, #666B75);
    }

    &:not(.disabled):hover {
      color: var(--vscode-icube--text-text-default-hover, #F5F9FE);
      background: var(--vscode-icube--bg-bg-overlay-l2, rgba(224, 226, 242, 0.05));
    }

