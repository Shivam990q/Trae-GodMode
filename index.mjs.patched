:root {
  --p: var(--color-text-primary);
  --s: var(--color-text-secondary);
  --t: var(--color-text-tertiary);
  --bg2: var(--color-background-secondary);
  --b: var(--color-border-secondary);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
input, select, textarea, button { font-family: inherit; }
body {
  font-family: var(--font-sans);
  color: var(--color-text-primary);
  background: var(--color-background-primary);
  padding: 16px;
}
html, body { scrollbar-width: thin; overflow: auto; }
h1,h2,h3,h4,h5,h6 { color: var(--color-text-primary); }
#__widget_root__ { display: flow-root; }
#__widget_root__ > svg { max-width: 100%; height: auto; display: block; }

.t { font-size: 14px; fill: var(--p); }
.ts { font-size: 12px; fill: var(--s); }
.th { font-size: 14px; fill: var(--p); font-weight: 500; }
.box { fill: var(--bg2); stroke: var(--b); }
.arr { stroke: var(--t); fill: none; stroke-width: 1.5; }
.leader { stroke: var(--t); stroke-width: 0.5; stroke-dasharray: 4 3; fill: none; }
.node { cursor: pointer; }
.node:hover rect, .node:hover .box { filter: brightness(0.97); }
.node:hover text { opacity: 0.8; }

input:not([type="range"]):not([type="checkbox"]):not([type="radio"]),
select,
textarea {
  width: 100%; height: 32px; padding: 6px 12px; font-size: var(--font-text-md-size);
  background: var(--color-background-primary); color: var(--color-text-primary);
  border: 1px solid var(--color-border-tertiary); border-radius: var(--border-radius-md);
  outline: none; transition: border-color 0.15s, box-shadow 0.15s;
}
textarea { height: auto; min-height: 80px; resize: vertical; }
input:not([type="range"]):not([type="checkbox"]):not([type="radio"]):hover,
select:hover, textarea:hover { border-color: var(--color-border-primary); }
input:not([type="range"]):not([type="checkbox"]):not([type="radio"]):focus,
select:focus, textarea:focus {
  border-color: var(--color-border-primary); box-shadow: 0 0 0 3px var(--color-background-primary);
}
select { cursor: pointer; }
input[type="range"] {
  -webkit-appearance: none; appearance: none; width: 100%; height: 4px;
  background: light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.1));
  border-radius: var(--border-radius-xs); outline: none;
}
input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none; width: 18px; height: 18px; border-radius: 50%;
  background: var(--color-background-primary); border: 1px solid var(--color-border-secondary);
  cursor: pointer; transition: border-color 0.15s, transform 0.15s;
}
input[type="range"]:hover::-webkit-slider-thumb { border-color: var(--color-border-primary); transform: scale(1.1); }
input[type="range"]::-moz-range-thumb {
  width: 18px; height: 18px; border-radius: 50%;
  background: var(--color-background-primary); border: 1px solid var(--color-border-secondary); cursor: pointer;
}
button {
  padding: 8px 12px; font-size: var(--font-text-md-size); background:var(--color-background-overlay-l3);
  color: var(--color-text-primary); border: 0px solid var(--color-border-secondary);
  border-radius: var(--border-radius-sm); cursor: pointer;
  transition: background 0.15s, transform 0.1s;
}
button:hover { background: var(--color-background-overlay-l4); }
button:active { background: var(--color-background-overlay-l3); transform: scale(0.98); }

g.c-coral>rect,g.c-coral>ellipse,g.c-coral>circle,g.c-coral>polygon,
rect.c-coral,ellipse.c-coral,circle.c-coral,polygon.c-coral{fill:light-dark(var(--color-coral-1),var(--color-coral-9));stroke:light-dark(var(--color-coral-7),var(--color-coral-5))}
.c-coral>.th,.c-coral>.t{fill:light-dark(var(--color-coral-9),var(--color-coral-3))}
