`,nl.input`
  opacity: 0;
  width: 0;
  height: 0;

  &:checked + span {
    background-color: var(--vscode-button-background);
  }

  &:checked + span:before {
    transform: translateX(16px);
  }

  &:focus + span {
    box-shadow: 0 0 1px var(--vscode-button-background);
  }

  &:disabled + span {
    opacity: 0.4;
    cursor: not-allowed;
  }
`,nl.span`
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--vscode-button-secondaryBackground);
  transition: .2s;
  border-radius: 20px;

  &:before {
    position: absolute;
    content: "";
    height: 16px;
    width: 16px;
    left: 2px;
    bottom: 2px;
    background-color: var(--vscode-button-foreground);
    transition: .2s;
    border-radius: 50%;
  }
`,nl.div`
  display: flex;
  gap: 8px;
`,nl.button`
  display: flex;
  align-items: center;
  gap: 8px;
  padding: ${e=>"radio"===e.type?"4px":"4px 12px"};
  height: 28px;
  font-size: 13px;
  font-weight: 500;
  line-height: 20px;
  cursor: pointer;
  transition: all 0.1s linear;
  background-color: ${e=>"radio"===e.type?"transparent":e.checked?"var(--vscode-icube-primaryButtonBackground)":"var(--vscode-icube-defaultButtonBackground)"};
  color: ${e=>"radio"===e.type?"var(--vscode-icube-colorDefaultText)":e.checked?"var(--vscode-icube-primaryButtonForeground)":"var(--vscode-icube-defaultButtonForeground)"};

  &:hover {
    background-color: ${e=>"radio"===e.type?"transparent":e.checked?"var(--vscode-icube-primaryButtonHoverBackground)":"var(--vscode-icube-defaultButtonHoverBackground)"};
  }

  &:focus {
    outline: none !important;
  }

  &.light {
    color: ${e=>"radio"===e.type?"var(--vscode-icube-colorDefaultText)":void 0};
  }
`,nl.span`
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 2px solid ${e=>e.checked?"var(--vscode-icube-colorBrand)":"var(--vscode-icube-colorLine2)"};
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;

  &::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vscode-icube-colorBrand);
    opacity: ${e=>+!!e.checked};
    transition: all 0.2s;
  }
`,nl.div`
  display: flex;
  flex-direction: column;
  gap: 8px;
`,nl.label`
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  border-radius: 4px;
  transition: all 0.1s linear;
  user-select: none;
  &:hover {
    background-color: ${e=>e.checked?"var(--vscode-icube-colorBtnHover)":"var(--vscode-icube-colorBtnHover2)"};
  }
