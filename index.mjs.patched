`,LT=c5.Ay.div`
    width: 100%;
    position: relative;

    & .icube-ai-custom-agent-share-mcp-accordion-mcp-input {
      margin: 0;
      box-sizing: border-box;
      width: 100%;
      max-height: 184px;
      position: relative;
      border: ${e=>e.$inContentWrapper?"none":"1px solid var(--vscode-icube-colorLine1)"};
      border-radius: ${e=>e.$inContentWrapper?"0":"6px"};

      &:not(.readonly) {
        background: var(--vscode-icube-colorBgTr1);
      }

      &.readonly {
        & .cm-editor .cm-content {
          cursor: not-allowed;
          color: var(--vscode-icube-colorGrayText);
        }
      }

      &.error {
        border-color: var(--vscode-icube-colorError);
      }

      &:not(.readonly):not(.error):hover {
        border-color: ${e=>e.$inContentWrapper?"transparent":"var(--vscode-icube-colorTextDisable)"};
      }
    }

    & .tag {
      position: absolute;
      top: 8px;
      right: 8px;
      color: var(--vscode-icube-colorGrayText);
      background: var(--vscode-icube-colorBgTr1);
      box-shadow: inset 0 0 0 1px var(--vscode-icube-colorLine1);
      height: 16px;
      box-sizing: border-box;
      padding: 0 4px;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;

      & .tag-inner {
        font-weight: 500;
        font-size: 11px;
        line-height: 16px;
        letter-spacing: 0;
        vertical-align: baseline;
      }
    }
