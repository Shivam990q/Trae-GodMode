  &.canShowTool {
    cursor: pointer;
  }

  .agent-extension-content {
    padding: 0 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    /* border-bottom: 1px solid var(--vscode-icube-colorLine1); */

    &.servers {
      padding-left: 8px;

      .add-to-agent-container, .separator, .operation {
        opacity: 0;
      }
    }

    .agent-extension-arrow {
      font-size: 12px;
      color: var(--vscode-icube--icon-icon-secondary);
      margin-right: 8px;

      &.disabled {
        color: var(--vscode-icube-colorDisableText);
      }
    }

    & .agent-extension-name {
      color: var(--vscode-icube-colorDefaultText);
      & svg {
        color: var(--vscode-icube-colorGrayText);
        font-size: 12px;
        margin-left: 4px;
      }
      &.clickable {
        cursor: pointer;
        &:hover {
          color: var(--vscode-icube-colorHighlightText);
          & svg {
            color: var(--vscode-icube-colorHighlightText);
          }
          text-decoration: underline;
        }
      }

      &__workspace_suffix {
        font-size: 12px;
        font-weight: 400;
        color: var(--vscode-icube-colorGrayText);
        margin-left: 4px;
        white-space: nowrap;
      }
    }
  }

  &.active .agent-extension-content {
    border-bottom: none;
  }

  h2 {
    font-size: 13px;
    color: var(--vscode-icube-colorDefaultText);
    margin: 0;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    max-width: 100%;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  div[data-radix-popper-content-wrapper] {
    z-index: 9999 !important;
    .icube-dropdown {
      padding: 0;
    }
  }

  .tool-container {
    padding: 0 12px 12px;

    .tool-container-content {
      border: 1px solid var(--vscode-icube-colorLine1);
      background-color: var(--vscode-icube-colorBtnHover);
      border-radius: 4px;
      padding: 4px 12px;
    }
  }

  &:hover .servers,
  & .servers:has(div[data-radix-popper-content-wrapper]) {
    .add-to-agent-container, .separator, .operation {
      opacity: 1;
    }
  }
`,D$=c5.Ay.span`
  display: inline-flex;
  align-items: center;
  margin-left: var(--spacer-4, 4px);
  color: var(--vscode-icube--icon-icon-tertiary, var(--icon-icon-tertiary));
  font-size: var(--font-size-base, 14px);
  line-height: 1;
  cursor: default;
`,DK=c5.Ay.div`
  display: flex;
`,DZ=c5.Ay.div`
