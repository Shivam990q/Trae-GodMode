    border: 1px solid var(--vscode-icube-colorLine1);
    /*background-color: var(--vscode-icube-colorBg3);*/
    background-color: var(--vscode-icube-colorBtnHover);
    border-radius: 6px;
    padding: 8px;
  }

  .PopoverTitle {
    font-size: 14px;
    color: var(--vscode-icube-colorHighlightText);
    display: flex;
    align-items: center;
    justify-content: space-between;
    .newide-icon-Close {
      cursor: pointer;
    }
  }
