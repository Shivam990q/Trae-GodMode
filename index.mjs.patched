  .agent-extension-editor-modal {
    & .icd-modal-content {
      & .icd-modal-header {
        & .icd-modal-title {
          font-size: 16px;
          /* 用于 title 内容超长情况下的省略展示，20px 是关闭图标的宽度 */
          width: calc(100% - 20px);
        }
        & .icd-modal-close {
          font-size: 20px;
        }
      }
      padding: 12px;
      position: relative;
      width: 60%;
      box-sizing: border-box;
      max-width: 600px;
      min-width: min(400px, 90%);
      background: var(--vscode-icube-colorBg3);

      .vs-dark & {
        background: var(--vscode-icube-colorBg2);
      }

      & .icd-modal-header {
        padding: 2px 0;
      }

      & .icd-modal-body {
        margin-top: 16px;
        padding: 0;
      }
    }

    & .json-btn {
      position: absolute;
      top: 12px;
      right: 48px;
    }
  }
