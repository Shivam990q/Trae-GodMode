`;let D_=c5.Ay.div`
  .agents {
    display: flex;
    height: 20px;
    padding: 4px;
    align-items: center;
    border-radius: 4px;

    &:hover {
      background: var(--vscode-icube-colorBgTr1);

      .add-agent-avatar {
        border: 2px solid var(--vscode-icube-colorBg3, #33363d) !important;
      }
    }

    &.disabled {
      cursor: not-allowed;
      opacity: 0.5;
    }

    .add-agent-avatar {
      border-radius: 4px !important; // TODO: 增加 2px 的圆角抵消 2px 的边框，需要优化一下
      border: 2px solid var(--vscode-icube-colorBg2, #24262b) !important;
    }

    .add-agent-avatar:not(:first-child) {
      margin-left: -8px;
    }

    .add-agent-avatar-plus {
      color: var(--vscode-icube-colorDefaultText);
      border-radius: 2px;
      background: var(--vscode-icube-colorBgTr3);
      width: 16px;
      height: 16px;
      font-size: 12px;
      margin-left: 2px;
      display: flex;
      justify-content: center;
      align-items: center;
    }
  }
