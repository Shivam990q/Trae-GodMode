  display: flex;
  align-items: center;
  border-bottom: 1px solid var(--vscode-icube-colorLine1);
  height: 32px;
  padding: 0 4px;
  cursor: default;

  &:last-child {
    border-bottom: none;
  }

  .server-tool-name {
    width: 40%;
    font-size: 12px;
    font-weight: 500;
    color: var(--vscode-icube-colorDefaultText);
    margin: 0;
    display: flex;
    align-items: center;
    .newide-icon {
      margin-right: 12px;
      font-size: 16px;
      color: var(--vscode-icube-colorC9);
    }
  }

  .server-tool-name-text {
    width: calc(100% - 40px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .server-tool-description {
    height: 18px;
    width: 60%;
  }

  .server-tool-description .server-tool-description-content {
    width: 100%;
    font-size: 12px;
    line-height: 18px;
    margin: 0;
    white-space: nowrap;
    color: var(--vscode-icube-colorGrayText);
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: right;
    font-weight: 400;
  }
