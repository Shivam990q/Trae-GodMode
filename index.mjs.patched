  .agent-extension-marketplace-modal {
    & .icd-modal-content {
      overflow: hidden;
      & .icd-modal-header {
        padding: 0 12px;
        & .icd-modal-title {
          font-size: 16px;
          /* 用于 title 内容超长情况下的省略展示，20px 是关闭图标的宽度 */
          width: calc(100% - 20px);
        }
        & .icd-modal-close {
          font-size: 20px;
        }
      }
      padding: 12px 0;
      position: relative;
      width: 60%;
      box-sizing: border-box;
      max-width: 600px;
      min-width: min(400px, 90%);
      background: var(--vscode-icube-colorBg3);

      .vs-dark & {
        background: var(--vscode-icube-colorBg2);
      }

      & .icd-modal-body {
        margin-top: 20px;
        padding: 0;
      }
    }
  }

  .pane-composite-part[id="workbench.parts.auxiliarybar"] .icd-modal-overlay {
    // 这里要比 10 高，不然会被output 面板的 sticky 挡住
    // 参考样式：lib/vscode/src/vs/editor/contrib/stickyScroll/browser/stickyScroll.css
    z-index: 11;
  }
