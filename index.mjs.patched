    /* arrow */
    #arrowhead {
        fill: #7F848E;
    }
    text {
        fill: var(--vscode-icube--text-text-default);
    }
    #arrowhead path {
        fill: #7F848E;
        stroke: #7F848E;
    }
     #crosshead path {
        fill: #7F848E;
        stroke: #7F848E;
     }
    /* sequence */
    .node rect, .node circle,  .node ellipse,  .node polygon, .node path {
        fill: var(--vscode-icube--bg-bg-base-tertiary);
    }
    .nodeLabel {
        color: var(--vscode-icube--text-text-default);
    }
    .actor {
        fill: var(--vscode-icube--bg-bg-base-tertiary);
        stroke: var(--vscode-icube--accent-accent-teal);
    }
    .actor-man line {
        stroke: #7F848E;
        fill: #7F848E;
    }
    .actor-line {
        stroke: #7F848E;
         fill: #7F848E;
         stroke-width: 1px;
     }
    .messageLine0 {
        stroke: #7F848E;
        stroke-width: 1px;
    }
    .messageLine1 {
        stroke: #7F848E;
        stroke-width: 1px;
    }
    .transition {
        stroke: #7F848E;
    }
    .statediagram-note rect {
        fill: var(--vscode-icube--bg-bg-base-tertiary);
        stroke: var(--vscode-icube--accent-accent-amber);
    }
    circle.state-start {
        stroke: #7F848E !important;
        fill: var(--vscode-icube--bg-bg-base-tertiary) !important;
    }
    circle.state-end {
      fill: var(--vscode-icube--bg-bg-base-tertiary) !important;
      stroke: var(--vscode-icube--accent-accent-teal) !important;
      stroke-width: 1px !important;
    }
    .entityBox {
        fill: var(--vscode-icube--bg-bg-base-tertiary);
    }
    .relationshipLine {
        stroke: #7F848E !important;
    }
    .relationshipLabelBox {
        fill: var(--vscode-icube--bg-bg-base-tertiary);
        opacity: unset;
        background-color: hsl(80, 100%, 96.2745098039%);
    }
    line {
        stroke: #7F848E;
    }
    /* class */
    .classDiagramTitleText {
        font-weight: 600;
    }
    /* quadrant */
     .quadrants .quadrant text {
        fill: var(--vscode-icube--text-text-default) !important;
    }
    .quadrants .quadrant:nth-child(1) rect {
        fill: var(--vscode-icube--bg-bg-overlay-l4) !important;
    }
    .quadrants .quadrant:nth-child(2) rect {
        fill: var(--vscode-icube--bg-bg-overlay-l3) !important;
    }
    .quadrants .quadrant:nth-child(3) rect {
        fill: var(--vscode-icube--bg-bg-overlay-l2) !important;
    }
    .quadrants .quadrant:nth-child(4) rect {
        fill: var(--vscode-icube--bg-bg-overlay-l1) !important;
    }
     .labels .label text{
       fill: var(--vscode-icube--text-text-default) !important;
       font-size: var(--body-md-fontSize, 12px);
       font-weight: var(--body-md-fontWeight, 400);
    }
    /* user journey */
    .actor-0 {
        fill: ${M};
    }
    .actor-1 {
        fill: ${E};
    }
    .actor-2 {
        fill: ${k};
    }
    .actor-3 {
        fill: ${x};
    }
    .actor-4 {
        fill: ${S};
    }
     .actor-5 {
        fill: ${w};
    }
    /* requeirement */
    .reqTitle {
        fill:  var(--vscode-icube--text-text-default);
    }
    .reqLabel {
        fill: var(--vscode-icube--text-text-default);
    }
    /* timeline */
    .lineWrapper line {
        stroke: #7F848E;
    }
    /* minimap */
    .section-root text {
        fill: var(--vscode-icube--text-text-default);
    }
    /* radar */
    .radarTitle {
        font-weight: 600;
    }
    /* architecture */
    .architecture-groups g svg rect,
     .architecture-services rect {
        fill: ${M} !important;
    }
    .edge {
        stroke: ${Y};
    }
    .node-bkg {
        stroke: ${Y};
    }
    .node .cluster {
        stroke: var(--vscode-icube--bg-bg-base-tertiary);
    }
    .face {
        fill: var(--vscode-icube--bg-bg-base-tertiary);
        stroke: ${g};
    }
    /* quadrant */
    .title text {
        font-size: 13px !important;
        font-weight: 600;
    }
    /* packet */
    .packetBlock {
        fill: var(--vscode-icube--bg-bg-base-tertiary);
        stroke: ${g};
    }
    .packetLabel {
     fill: var(--vscode-icube--text-text-default);
    }
    .packetTitle {
        fill: var(--vscode-icube--text-text-default);
        font-size: 13px;
        font-weight: 600;
    }
    .packetByte.start, .packetByte.end {
        fill: var(--vscode-icube--text-text-default);
    }
    /* git */
    .label0, .label1, .label2, .label3, .label4, .label5, .label6, .label7 {
        fill: none;
    }
    /* pie */
    text.slice {
        fill: var(--vscode-icube--text-text-onbrand) !important;
    }
