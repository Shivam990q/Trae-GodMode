  max-width: 268px !important;
  width: 268px;
  box-sizing: border-box;
  border-radius: var(--Radius-radius-8, 8px);
  z-index: 10000;
  padding: 12px;
  background-color: var(--vscode-icube--bg-bg-tooltip, #1A1B1D);
  border: 1px solid var(--border-border-neutral-l1, rgba(224, 226, 242, 0.09));
  box-shadow: var(--vscode-icube-elevation-200-menu-panel);
  animation-duration: 400ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  will-change: transform, opacity;
  &[data-state='open'][data-side='top'] {
    animation-name: slideDownAndFade;
  }
  &[data-state='open'][data-side='right'] {
    animation-name: slideLeftAndFade;
  }
  &[data-state='open'][data-side='bottom'] {
    animation-name: slideUpAndFade;
  }
  &[data-state='open'][data-side='left'] {
    animation-name: slideRightAndFade;
  }

  &.desktop {
    .popconfirm-warning, .popconfirm-info {
    }
  }

  &.fullBtn {
    .popconfirm-cancel, .popconfirm-confirm {
      flex: 1;
    }
  }

  @keyframes slideUpAndFade {
    from {
      opacity: 0;
      transform: translateY(2px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideRightAndFade {
    from {
      opacity: 0;
      transform: translateX(-2px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideDownAndFade {
    from {
      opacity: 0;
      transform: translateY(-2px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideLeftAndFade {
    from {
      opacity: 0;
      transform: translateX(2px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
