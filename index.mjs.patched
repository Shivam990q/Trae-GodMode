  flex: 1;
  position: relative;
  width: 0px;
  font-size: 14px;
  color: var(--vscode-icube-colorHighlightText);
`,DJ=c5.Ay.p`
  font-size: 12px;
  margin: 0;
  color: var(--vscode-icube-colorGrayText);
  overflow: hidden;
  width: 100%;
  text-overflow: ellipsis;
  white-space: nowrap;
