  background: var(--vscode-icube--bg-bg-tooltip, #1a1b1d);
  border: 1px solid var(--vscode-icube--border-border-neutral-l1, rgba(224, 226, 242, 0.09));
  border-radius: 8px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow:
    0px 0px 0.5px 0px rgba(0, 0, 0, 0.12),
    0px 1px 3px 0px rgba(0, 0, 0, 0.08),
    0px 4px 8px 0px rgba(0, 0, 0, 0.12);
  z-index: 10000;
  max-width: 280px;
  min-width: 200px;
  outline: none;
  animation-duration: 200ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  will-change: transform, opacity;

  &[data-state='open'][data-side='top'] {
    animation-name: icdConfirmBubbleSlideDownAndFade;
  }
  &[data-state='open'][data-side='right'] {
    animation-name: icdConfirmBubbleSlideLeftAndFade;
  }
  &[data-state='open'][data-side='bottom'] {
    animation-name: icdConfirmBubbleSlideUpAndFade;
  }
  &[data-state='open'][data-side='left'] {
    animation-name: icdConfirmBubbleSlideRightAndFade;
  }

  @keyframes icdConfirmBubbleSlideUpAndFade {
    from {
      opacity: 0;
      transform: translateY(2px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes icdConfirmBubbleSlideDownAndFade {
    from {
      opacity: 0;
      transform: translateY(-2px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes icdConfirmBubbleSlideLeftAndFade {
    from {
      opacity: 0;
      transform: translateX(2px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes icdConfirmBubbleSlideRightAndFade {
    from {
      opacity: 0;
      transform: translateX(-2px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .icd-confirm-bubble-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .icd-confirm-bubble-header {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .icd-confirm-bubble-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;

    svg {
      width: 18px;
      height: 18px;
    }
  }

  .icd-confirm-bubble-title {
    font-size: 13px;
    font-weight: 600;
    line-height: 20px;
    color: var(--vscode-icube--text-text-default-active);
  }

  .icd-confirm-bubble-desc {
    font-size: 12px;
    line-height: 18px;
    color: var(--vscode-icube--text-text-secondary);
  }

  .icd-confirm-bubble-footer {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    align-items: center;
  }

  .icd-confirm-bubble-btn {
    height: 24px;
    border-radius: 4px;
    padding: 0 10px;
    font-size: 13px;
    font-weight: 500;
    line-height: 20px;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .icd-confirm-bubble-btn-cancel {
    background: var(--vscode-icube--bg-bg-overlay-l3, rgba(224, 226, 242, 0.08));
    color: var(--vscode-icube--text-text-default, #d1d3db);
  }

  .icd-confirm-bubble-btn-confirm {
    background: var(--vscode-icube--bg-bg-invert, #dadde5);
    color: var(--vscode-icube--text-text-onaccent, #0c0c0d);
  }
`,l=(0,a.Ay)(i.i3)`
  fill: var(--vscode-icube--bg-bg-tooltip, #1a1b1d);
  position: relative;

  polygon {
    stroke: var(--vscode-icube--border-border-neutral-l1, rgba(224, 226, 242, 0.09));
    stroke-width: 1px;
  }

  [data-side='top'] > & {
    top: 1px;
  }
  [data-side='bottom'] > & {
    bottom: 1px;
  }
  [data-side='left'] > & {
    left: 1px;
  }
  [data-side='right'] > & {
    right: 1px;
  }
