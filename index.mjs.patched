`,uF=nl.div`
  border: 1px solid var(--vscode-icube-colorLine2);
  background-color: var(--vscode-icube-colorBtnHover);
  font-size: 13px;
  line-height: 20px;
  display: flex;
  align-items: center;
  padding: 4px 12px;
  border-radius: 4px;
  width: 100%;
  box-sizing: border-box;

  .prefix-input-icon {
    margin-right: 4px;
    display: flex;
    align-items: center;
    color: var(--vscode-icube-colorGrayText);
  }

  &.disabled {
    border-color: var(--vscode-icube-colorLine1) !important;
    color: var(--vscode-icube-colorDisableText) !important;
  }

  &.error {
    border-color: var(--vscode-icube-colorError) !important;
  }


  &:hover,
  &.active {
    border: 1px solid var(--vscode-icube-colorTextDisable);
  }


  &.count-error {
    border: 1px solid var(--vscode-icube-colorError, #CC4B53);
  }

  &.active input {
     color: var(--vscode-icube-colorTextHighlight);
  }

  input {
    outline: none;
    background-color: transparent;
    width: 100%;
    border: none;
    font-weight: 400;
  }

  input::placeholder {
    color: var(--vscode-icube-colorTextGray);
    font-weight: 400;
  }
