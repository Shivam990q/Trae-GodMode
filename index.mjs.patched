  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  .empty-page-banner {
    display: block;
    width: 400px;
    max-width: 90%;
    margin-bottom: 40px;
    border-radius: 4px;
    aspect-ratio: 10 / 7;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
  }

  .empty-page-title {
    font-weight: 600;
    font-size: 20px;
    text-align: center;
    margin-bottom: 20px;
    color: var(--vscode-icube--text-text-default-active);
  }

  .empty-page-description {
    max-width: 480px;
    font-weight: 500;
    font-size: 12px;
    line-height: 18px;
    text-align: center;
    color: var(--vscode-icube--text-text-secondary);
    margin-bottom: 40px;
    padding: 0 36px;
  }

  .empty-page-buttons {
    display: flex;
    gap: 12px;
    margin-bottom: 40px;

    & .empty-page-button {
      height: 28px;
      min-width: 100px;
      padding: 4px 8px;
      box-sizing: border-box;
      font-size: 13px;
      color: var(--vscode-icube--text-text-onaccent);

      &.empty-page-button__add-manually {
        color: var(--vscode-icube--text-text-default);
      }

      .icd-btn-content {
        display: flex;
        align-items: center;
      }
    }
  }
