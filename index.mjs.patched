  width: 100%;
  border-radius: 6px;
  box-sizing: border-box;

  & .wrapper {
    box-shadow: 0 0 0 1px var(--vscode-icube-colorLine2);
    border-radius: 6px;
    max-height: calc(90vh - 104px);
    overflow-y: auto;
    scrollbar-width: none;

    & .schemas-wrapper {
      position: relative;
      &::before,
      &::after {
        content: ' ';
        display: block;
        position: absolute;
        left: 0;
        width: 100%;
        height: 32px;
        pointer-events: none;
        transform: translateZ(0);
        z-index: 10;
        opacity: 0;
        transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 6px;
      }

      &.sticky-top::before {
        top: 0;
        opacity: 1;
        background: linear-gradient(180deg, var(--vscode-icube-colorBg2) 0%, rgba(0, 0, 0, 0) 100%);
      }

      &.sticky-bottom::after {
        bottom: 0;
        opacity: 1;
        background: linear-gradient(0deg, var(--vscode-icube-colorBg2) 0%, rgba(0, 0, 0, 0) 100%);
      }
    }

    & .schemas {
      position: relative;
      max-height: 245px;
      overflow: auto;
      display: flex;
      padding: 12px;
      flex-direction: column;
      row-gap: 16px;
      box-shadow: var(--vscode-icube-box-shadow2);
      border-radius: 6px;
      box-shadow: 0 0 0 1px var(--vscode-icube-colorLine2);
      scrollbar-width: none;
      .vs-dark & {
        background: var(--vscode-icube-colorBg2);
      }
    }

    & .schema {
      display: flex;
      flex-direction: column;
      gap: 8px;
      border-radius: 6px;

      & .title {
        font-weight: 500;
        color: var(--vscode-icube-colorDefaultText);
        font-size: 13px;
        line-height: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        width: 100%;
        justify-content: space-between;
      }

      & .title-content {
        display: flex;
        align-items: center;
        gap: 2px;
        overflow: hidden;
      }

      & .title-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      & .required-mark {
        color: var(--vscode-icube-colorError);
      }

      & .custom-info-icon {
        display: flex;
        white-space: nowrap;
        flex-shrink: 0;
      }

      & .input {
        background: var(--vscode-icube-colorBgTr1);
        &.error {
          border: 1px solid var(--vscode-icube-colorError);
        }
        & input:focus::placeholder {
          color: transparent;
        }
      }
    }

    & .editor-container {
      position: relative;
      & .tag {
        position: absolute;
        right: 9px;
        top: 9px; // 使用 box-shadow 替代 border，需要手动加 1px
        color: var(--vscode-icube-colorGrayText);
        background: var(--vscode-icube-colorBgTr1);
        box-shadow: inset 0 0 0 1px var(--vscode-icube-colorLine1);
        height: 16px;
        box-sizing: border-box;
        padding: 0 4px;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;

        & .tag-inner {
          font-weight: 500;
          font-size: 11px;
          line-height: 16px;
          letter-spacing: 0;
          vertical-align: baseline;
        }
      }
    }

    & .config-editor-input {
      & .cm-editor .cm-content {
        color: var(--vscode-icube-colorGrayText);
      }
    }
  }
